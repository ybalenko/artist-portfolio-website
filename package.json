{
  "name": "yulia-balenko-artist-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "contact:synth": "cdk synth --app \"node infra/contact-form/cdk-app.mjs\"",
    "contact:test": "node --experimental-strip-types --test infra/contact-form/lambda/rate-limit.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:e2e": "ASTRO_TELEMETRY_DISABLED=1 PUBLIC_CONTACT_API_URL= astro build --outDir .playwright/site",
    "preview:e2e": "ASTRO_TELEMETRY_DISABLED=1 PUBLIC_CONTACT_API_URL= astro preview --outDir .playwright/site --host 127.0.0.1 --port 4322",
    "test:e2e": "playwright test",
    "test:e2e:home": "playwright test home.spec.ts",
    "test:e2e:portfolio": "playwright test portfolio.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:check": "tsc --project tests/e2e/tsconfig.json"
  },
  "engines": {
    "node": ">=22.12.0 <25",
    "npm": ">=10"
  },
  "packageManager": "npm@10.9.0",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1090.0",
    "@aws-sdk/client-sesv2": "^3.1090.0",
    "@aws-sdk/client-ssm": "^3.1090.0",
    "@fontsource/lato": "5.2.7",
    "astro": "7.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.1.1",
    "aws-cdk": "^2.1132.0",
    "aws-cdk-lib": "^2.261.0",
    "constructs": "^10.7.0",
    "esbuild": "^0.28.1",
    "prettier": "3.8.4",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3"
  }
}
